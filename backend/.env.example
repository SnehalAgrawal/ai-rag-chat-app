# Copy this file to .env and fill in your values.

# --- Model provider ---------------------------------------------------------
# OpenAI (default): set your key and pick a chat model your account can use.
# The models this project was first built with (gpt-4, gpt-3.5-turbo) were shut
# down by OpenAI on 2026-10-23; see https://platform.openai.com/docs/deprecations
OPENAI_API_KEY=your_openai_api_key
CHAT_MODEL=your_chat_model
EMBEDDING_MODEL=text-embedding-3-small

# Local alternative, no API key (Ollama, https://ollama.com). Uncomment these
# and pull the models first: ollama pull llama3.2:3b && ollama pull nomic-embed-text
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# CHAT_MODEL=llama3.2:3b
# EMBEDDING_MODEL=nomic-embed-text

# --- Vector database --------------------------------------------------------
WEAVIATE_HOST=http://localhost:8080
# WEAVIATE_API_KEY=your_weaviate_api_key_if_any

# --- Server -----------------------------------------------------------------
PORT=4000
