{
  "name": "ai-rag-chat-app",
  "version": "0.1.0",
  "description": "Chat with your documents: hybrid search, reranking, and answers that cite their sources, runnable locally with no accounts, measured on frozen question sets.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ingest": "node scripts/ingest.js",
    "test": "node --test",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "eval:retrieval": "node scripts/eval-retrieval.js",
    "models": "node scripts/download-models.js",
    "eval:rerank": "node scripts/eval-rerank.js",
    "tune:gate": "node scripts/tune-gate.js",
    "eval:answers": "node scripts/eval-answers.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@huggingface/transformers": "4.3.2"
  }
}
