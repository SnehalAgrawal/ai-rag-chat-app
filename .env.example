# Copy to .env to change a setting. With no .env, everything runs locally with Ollama:
# no accounts and no API keys.

# DATABASE_PATH=data/app.db
# PORT=3000
# HOST=127.0.0.1                    # 0.0.0.0 makes the app reachable from your network (it has no accounts)
# MAX_UPLOAD_MB=20

# --- Answers (LLM) -----------------------------------------------------------
# ollama (default, local), openai-compatible (OpenAI or any compatible API), or
# anthropic (Claude, through Anthropic's SDK).
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:3b
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MAX_TOKENS=           # default 1024; 16000 for Claude (its thinking counts against it)
# LLM_TEMPERATURE=0         # ignored by Claude
# LLM_SEED=                 # ignored by Claude
# LLM_NUM_CTX=8192          # ollama only
# LLM_EFFORT=               # anthropic only: low, medium (default), high, xhigh, max

# Example, OpenAI:
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your-openai-key

# Example, Claude:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your-anthropic-key   # or ANTHROPIC_API_KEY
# LLM_MODEL=claude-opus-5-5        # the default

# --- Embeddings ----------------------------------------------------------------
# ollama (default: nomic-embed-text) or openai-compatible (default: text-embedding-3-small).
# Anthropic has no embeddings API. Changing the model means re-embedding the documents.
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# --- Retrieval and reranking ---------------------------------------------------
# The measured default: vector search's top 10, reranked by a local cross-encoder.
# RERANKER=mxbai-rerank-xsmall-v1   # or llm-judge (llama3.2:3b through Ollama, ~10x slower), or none
# RERANK_PRECISION=fp32             # q8 is a third of the size, but its scores depend on the batch (see the README)
# RERANK_CANDIDATES=10
# RETRIEVAL_METHOD=                 # default: vector with a reranker, rrf without one
# RETRIEVAL_BUDGET=1000             # tokens of retrieved text given to the model

# --- Answers -------------------------------------------------------------------------
# CITATIONS=numbers                 # or quotes: exact quotes, checked against the excerpts (see the README)
# REWRITE=true                      # rewrite follow-ups into stand-alone questions
# GATE=off                          # or vector / rerank: decline below a tuned threshold (npm run tune:gate)
